# Postgres. Locally, `npm run db:dev` prints a URL like the one below.
# On Vercel, add a Postgres database (e.g. Neon from the Marketplace);
# it sets DATABASE_URL for you.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"
# Public base URL (used for share links + OAuth callback)
APP_URL="http://localhost:3000"

# GitHub OAuth app (callback: $APP_URL/api/auth/github/callback).
# Leave empty to use built-in mock repos in development.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe. Leave empty to apply boosts instantly in development.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Vercel Blob for image uploads. Leave empty to write to public/uploads.
BLOB_READ_WRITE_TOKEN=""
